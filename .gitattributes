# --- Text files: normalize to LF ---
* text=auto eol=lf

# --- Unity assets: keep CRLF handling consistent ---
*.cs     text diff=csharp
*.shader text
*.cginc  text
*.compute text

# --- Binary formats: don't touch line endings ---
*.dll    binary
*.exe    binary
*.pdb    binary
*.so     binary
*.dylib  binary
*.a      binary
*.lib    binary
*.obj    binary

# --- Unity assets (binary) ---
*.unity  binary
*.prefab binary
*.asset  binary
*.meta   text
*.png    binary
*.jpg    binary
*.jpeg   binary
*.tga    binary
*.psd    binary
*.fbx    binary
*.anim   binary
*.controller binary
*.ttf    binary
*.otf    binary
*.wav    binary
*.mp3    binary
*.ogg    binary

# --- Wwise SoundBanks: use Git LFS ---
*.bnk filter=lfs diff=lfs merge=lfs -text
*.wem filter=lfs diff=lfs merge=lfs -text

# --- Build outputs (optional, if ever appear) ---
*.apk binary
*.ipa binary
*.zip binary